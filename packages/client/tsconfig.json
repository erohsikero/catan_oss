{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist-types",
    // Keep the incremental cache with the output it describes: a wiped
    // dist/ must not leave behind a cache claiming the build is current.
    "tsBuildInfoFile": "./dist-types/tsconfig.tsbuildinfo",
    "rootDir": "./src",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../shared" }]
}
